<?xml version="1.0" encoding="utf-8"?>
<!-- The logo's own circular badge already fills ~92-96% of its source canvas, so it
     is inset here to land inside Android's adaptive-icon safe zone (~66% of the 108dp
     canvas) instead of being clipped by circular/squircle launcher masks. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo"
    android:insetLeft="15%"
    android:insetTop="15%"
    android:insetRight="15%"
    android:insetBottom="15%" />
